rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Primary authorization: Custom claim { admin: true }
    // Fallback authorization: Verified admin email allowlist
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (
          request.auth.token.email == 'saidurrahman1004@gmail.com' &&
          request.auth.token.email_verified == true
        ) ||
        (
          request.auth.token.email == 'saidurrahman1004@gmail.com'
        )
      );
    }

    // 1. Portfolio Public Showcase Collections (Admin CRUD, Public Read)
    match /skills/{document} {
      allow read: if isAdmin() || resource.data.isVisible == true;
      allow write: if isAdmin();
    }
    
    match /projects/{document} {
      allow read: if isAdmin() || resource.data.isVisible == true;
      allow write: if isAdmin();
    }

    match /contact/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /experience/{document} {
      allow read: if isAdmin() || resource.data.isVisible == true;
      allow write: if isAdmin();
    }
    
    match /education/{document} {
      allow read: if isAdmin() || resource.data.isVisible == true;
      allow write: if isAdmin();
    }
    
    match /certifications/{document} {
      allow read: if isAdmin() || resource.data.isVisible == true;
      allow write: if isAdmin();
    }

    match /career_config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Inquiries: Public submission with size validation, Admin management
    match /inquiries/{document} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.email is string &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() <= 4000;
      allow read, update, delete: if isAdmin();
    }

    // 3. Error Monitoring: Admin triage, client sanitized reporting with size limit
    match /error_reports/{document} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.fingerprint is string &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() <= 8000;
    }

    // 4. Real-time Telemetry: Visitor metrics & daily aggregation
    match /analytics_realtime/{document} {
      allow read: if true;
      allow write: if true;
    }

    match /analytics_daily/{document} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Audit Logging: Admin-only read, authenticated Admin create, strictly immutable
    match /audit_logs/{document} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
                       request.resource.data.action is string &&
                       request.resource.data.resourceType is string;
      // Strictly prevent tampering or deletion of past audit records
      allow update, delete: if false;
    }

    // Explicitly deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
